{
  "name": "paintai",
  "version": "0.1.0",
  "private": true,
  "description": "A canvas your coding agent can actually see",
  "license": "MIT",
  "author": "Jamal Abdelkhalek",
  "repository": {
    "type": "git",
    "url": "https://github.com/jams4code/paintai.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "pnpm --filter paintai-desktop tauri dev",
    "build": "pnpm --filter paintai-desktop build",
    "release": "pnpm --filter paintai-desktop tauri build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter paintai-desktop exec tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all --check",
    "rust:fmt:fix": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all",
    "rust:clippy": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm rust:fmt && pnpm rust:clippy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
